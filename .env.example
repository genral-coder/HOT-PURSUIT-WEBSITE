# ═══════════════════════════════════════════════════════════════
#   HOT PURSUIT RP — Environment template
#   Copy this file to `.env` and fill real values.
#   NEVER commit the real `.env` file or any real secrets.
# ═══════════════════════════════════════════════════════════════

# --- Frontend (apps/web) ---
# Public URL of the API (used at build/runtime by the web app)
VITE_API_URL=http://localhost:4000/api

# --- Backend (apps/api) ---
# Port the REST API listens on
PORT=4000

# --- Discord OAuth2 (apps/api) ---
# NOTE: The Client Secret must NEVER be exposed to the frontend.
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Session / cookie secret (use a long random string)
SESSION_SECRET=

# --- Discord Bot (future) ---
DISCORD_BOT_TOKEN=

# --- PostgreSQL (apps/api) ---
DATABASE_URL=postgres://user:password@localhost:5432/hot_pursuit

# --- FiveM (future integration) ---
# FIVEM_SERVER_ADDRESS=
