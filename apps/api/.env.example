# HOT PURSUIT API — environment variables
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env`.

# ── Server ────────────────────────────────────────────────────────────
# Port the API listens on.
PORT=4000
# development | production
NODE_ENV=development
# Allowed frontend origin (CORS + OAuth redirect target).
CLIENT_ORIGIN=http://localhost:5173
# Public API base URL (used to build absolute checkout/dev URLs).
API_BASE_URL=http://localhost:4000

# ── PostgreSQL ────────────────────────────────────────────────────────
# Local example: postgresql://USER:PASSWORD@localhost:5432/hot_pursuit?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hot_pursuit?schema=public

# ── Session / cookies ─────────────────────────────────────────────────
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# false in development (no HTTPS). true in production.
SESSION_SECURE=false
# lax | none | strict
SESSION_SAMESITE=lax
# Session lifetime in milliseconds (7 days default).
# SESSION_MAX_AGE_MS=604800000

# ── Owner bridge (server-side admin authorization) ───────────────────
# Comma-separated Discord user ids that are granted OWNER access.
# ONLY these ids can become Owner (never self-assigned by a client).
OWNER_DISCORD_IDS=

# ── Discord OAuth ─────────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
# OAuth2 → Redirects: add http://localhost:4000/api/auth/discord/callback
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# ── Payments (Phase 6) ────────────────────────────────────────────────
# Configured backend: "" | "mock" | "stripe" | "paypal" | "tebex"
PAYMENT_PROVIDER=
# Currency used for order pricing (matches the catalog).
PAYMENT_CURRENCY=USD
# Shared secret used to verify payment webhook signatures.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret