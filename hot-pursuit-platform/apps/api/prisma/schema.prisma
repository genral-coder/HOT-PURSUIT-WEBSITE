// HOT PURSUIT RP — PostgreSQL schema (Phase 3 foundation + Phase 6 orders/payments + Phase 7 store)
//
// This schema establishes the secure user/auth/authorization foundation:
//   User, DiscordAccount, Role, Permission, UserRole, UserPermission, Favorite,
//   AuditLog
//
// Phase 6 adds the orders & payments foundation:
//   Order, OrderItem, PaymentEvent, ProductPrice
//
// Phase 7 makes PostgreSQL the canonical Store catalog:
//   Product, ProductCategory
//   * `Product` now IS the catalog source of truth (39 products, migrated from
//     the verified Store source). `Product.available=false` is the archive
//     state (soft delete — never removed).
//   * `ProductPrice` remains the trusted server-side pricing registry and is
//     FK'd to `Product` by the legacy numeric `productId`; it is kept in sync
//     by product edits/seed so orders keep re-pricing server-side.
//   * `Favorite.productId` / `OrderItem.productId` deliberately stay bare
//     integers (no FK): historical orders and user favorites must remain valid
//     even if a product is later archived.
//
// Legacy static files (products.json, apps/web/src/data/products.ts, the
// legacy store/admin pages and images) are preserved as migration source /
// reference backups. Runtime reads the database.
//
//  * All monetary values are stored as integer cents (no floating point).
//
// Future-phase tables (Application, Ticket, News, Media, Player, ...) are
// intentionally NOT created yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A site account. Created on first successful Discord login.
model User {
  id           String           @id @default(cuid())
  discordId    String           @unique
  discordAccount DiscordAccount?
  roles        UserRole[]
  permissions  UserPermission[]
  favorites    Favorite[]
  orders       Order[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([discordId])
}

/// Safe subset of Discord data stored for a user. Sensitive Discord data is
/// intentionally not stored.
model DiscordAccount {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  discordId  String   @unique
  username   String
  globalName String?
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A system role (OWNER, ADMIN, MODERATOR, CONTENT_MANAGER).
model Role {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime       @default(now())

  @@index([name])
}

/// A granular permission (e.g. "store.manage"). Evolves over time.
model Permission {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  roles       Role[]
  users       UserPermission[]
  createdAt   DateTime       @default(now())

  @@index([name])
}

/// Association table: user → role.
model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

/// Association table: user → direct permission grant (additive per-user).
model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
}

/// A favorited product for an authenticated user.
/// `productId` is the legacy numeric catalog id (bare int, no FK on purpose —
/// favorites stay valid even if a product is later archived).
model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  productId Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// Store product category (vehicles / mlo / vip / bundles). Seeded reference
/// data. Frontend display metadata (emoji/color) continues to live in the
/// legacy apps/web/src/data/store.ts — this table anchors category identity so
/// the public API and Admin management validate categories server-side.
model ProductCategory {
  id        String    @id
  name      String
  nameAr    String?
  emoji     String?
  color     String?
  products  Product[]
  createdAt DateTime  @default(now())
}

/// Store catalog product. PostgreSQL is the canonical catalog source of truth
/// since Phase 7. `productId` keeps the legacy numeric id (also used by
/// OrderItem and Favorite as a bare reference). `available=false` marks an
/// archived/hidden product — never a hard delete. Images are stored as path
/// references (legacy paths under images/products/…), never blobs.
model Product {
  id            String           @id @default(cuid())
  productId     Int              @unique
  category      ProductCategory  @relation(fields: [categoryId], references: [id])
  categoryId    String
  name          String
  nameAr        String?
  short         String?
  shortAr       String?
  description   String?
  descriptionAr String?
  features      String[]         @default([])
  featuresAr    String[]         @default([])
  /// Display price as a raw string (e.g. "20$ Monthly") — same as the legacy catalog.
  price         String
  /// Asset path reference (e.g. "images/products/mlo/Bennys LSIA.webp").
  image         String?
  /// Business subtype (only meaningful for category === "mlo").
  type          String?
  /// Vehicle class (only meaningful for category === "vehicles").
  class         String?
  sold          Boolean          @default(false)
  popular       Boolean          @default(false)
  new           Boolean?         @default(false)
  featured      Boolean?         @default(false)
  likes         Int?             @default(0)
  /// True = visible in the store. Archive sets this to false (soft delete).
  available     Boolean          @default(true)
  priceReg      ProductPrice?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productId])
  @@index([categoryId])
  @@index([available])
  @@index([sold])
  @@index([name])
}

/// Audit trail for privileged (admin) actions. Records who did what, to whom,
/// when. Only safe identifiers are stored — never passwords, tokens or secrets.
/// This is a foundation; actions are appended server-side by admin endpoints.
model AuditLog {
  id        String   @id @default(cuid())
  actorUser String
  actorRole String?
  action    String
  targetUser String?
  targetResource String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorUser])
  @@index([action])
  @@index([targetUser])
  @@index([createdAt])
}

/// Lifecycle of an order. Transitions are enforced server-side only
/// (see services/orders.ts — assertOrderTransition).
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

/// Payment state, tracked independently from the order lifecycle.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Which backend owns the payment (MANUAL = no provider configured, e.g. the
/// legacy Discord-ticket flow; MOCK = development-only simulator).
enum PaymentProviderType {
  MANUAL
  MOCK
  STRIPE
  PAYPAL
  TEBEX
}

/// Billing model of a product line as priced in the registry.
enum Billing {
  MONTHLY
  ONE_TIME
}

/// An order placed through checkout. Monetary values are integer cents.
/// `providerOrderId`/`providerPaymentId` are the external gateway references.
model Order {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  status          OrderStatus         @default(PENDING)
  paymentStatus   PaymentStatus       @default(UNPAID)
  currency        String              @default("USD")
  subtotalCents   Int
  discountCents   Int                 @default(0)
  totalCents      Int
  provider        PaymentProviderType @default(MANUAL)
  providerOrderId String?
  providerPaymentId String?
  items           OrderItem[]
  paymentEvents   PaymentEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([createdAt])
}

/// A single line of an order. name/image/price are SNAPSHOTS taken at order
/// time so historical orders stay correct even if the catalog or registry
/// changes later.
model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  productId      Int
  productName    String
  productNameAr  String?
  productImage   String?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  billing        Billing @default(MONTHLY)

  @@index([orderId])
  @@index([productId])
}

/// Every incoming payment webhook event. `@@unique([provider, eventId])` is
/// the database-level idempotency guard: a duplicated event cannot be applied
/// twice (no double-payment / double-processing).
model PaymentEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderType
  eventId     String
  eventType   String
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String?
  payloadHash String              @default("")
  processed   Boolean             @default(false)
  processedAt DateTime?
  createdAt   DateTime            @default(now())

  @@unique([provider, eventId])
  @@index([orderId])
  @@index([processed])
}

/// Trusted server-side pricing/snapshot registry. Used to re-price every order
/// line server-side. Kept in sync with the canonical `Product` catalog (FK by
/// the legacy numeric productId — one registry row per product). Not a full
/// product catalog (no features/descriptions) — only what orders need.
model ProductPrice {
  id          String   @id @default(cuid())
  product     Product? @relation(fields: [productId], references: [productId])
  productId   Int      @unique
  name        String
  nameAr      String?
  image       String?
  amountCents Int
  billing     Billing  @default(MONTHLY)
  currency    String   @default("USD")
  /// False when the product is sold out OR archived — such lines are rejected
  /// at checkout (server-side), never silently skipped.
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([available])
}
