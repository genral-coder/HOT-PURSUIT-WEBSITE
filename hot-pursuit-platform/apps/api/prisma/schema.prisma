// HOT PURSUIT RP — PostgreSQL schema (Phase 3 foundation + Phase 6 orders/payments)
//
// This schema establishes the secure user/auth/authorization foundation:
//   User, DiscordAccount, Role, Permission, UserRole, UserPermission, Favorite,
//   AuditLog
//
// Phase 6 adds the orders & payments foundation:
//   Order, OrderItem, PaymentEvent, ProductPrice
//
// DELIBERATE DECISIONS (honors the "no fake data" + "keep catalog static" rules):
//   * The Store product catalog remains static on the frontend (39 products,
//     source of truth). We do NOT create a full `Product` table or duplicate
//     those products here. `Favorite.productId` and `OrderItem.productId` are
//     therefore bare integers (no FK) mapped to the static catalog.
//   * `ProductPrice` is the *trusted server-side pricing registry* used to
//     re-price order lines at checkout/creation time. It stores name/image
//     snapshots and numeric amounts (cents) derived once from the static
//     catalog — the server NEVER trusts client-supplied prices/totals.
//   * All monetary values are stored as integer cents (no floating point).
//
// Future-phase tables (Application, Ticket, News, Media, Player, ...) are
// intentionally NOT created yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A site account. Created on first successful Discord login.
model User {
  id           String           @id @default(cuid())
  discordId    String           @unique
  discordAccount DiscordAccount?
  roles        UserRole[]
  permissions  UserPermission[]
  favorites    Favorite[]
  orders       Order[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([discordId])
}

/// Safe subset of Discord data stored for a user. Sensitive Discord data is
/// intentionally not stored.
model DiscordAccount {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  discordId  String   @unique
  username   String
  globalName String?
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A system role (OWNER, ADMIN, MODERATOR, CONTENT_MANAGER).
model Role {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime       @default(now())

  @@index([name])
}

/// A granular permission (e.g. "store.manage"). Evolves over time.
model Permission {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  roles       Role[]
  users       UserPermission[]
  createdAt   DateTime       @default(now())

  @@index([name])
}

/// Association table: user → role.
model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

/// Association table: user → direct permission grant (additive per-user).
model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
}

/// A favorited product for an authenticated user.
/// `productId` is the static-catalog integer id (no FK this phase — see header).
model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  productId Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// Audit trail for privileged (admin) actions. Records who did what, to whom,
/// when. Only safe identifiers are stored — never passwords, tokens or secrets.
/// This is a foundation; actions are appended server-side by admin endpoints.
model AuditLog {
  id        String   @id @default(cuid())
  actorUser String
  actorRole String?
  action    String
  targetUser String?
  targetResource String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorUser])
  @@index([action])
  @@index([targetUser])
  @@index([createdAt])
}

/// Lifecycle of an order. Transitions are enforced server-side only
/// (see services/orders.ts — assertOrderTransition).
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

/// Payment state, tracked independently from the order lifecycle.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Which backend owns the payment (MANUAL = no provider configured, e.g. the
/// legacy Discord-ticket flow; MOCK = development-only simulator).
enum PaymentProviderType {
  MANUAL
  MOCK
  STRIPE
  PAYPAL
  TEBEX
}

/// Billing model of a product line as priced in the registry.
enum Billing {
  MONTHLY
  ONE_TIME
}

/// An order placed through checkout. Monetary values are integer cents.
/// `providerOrderId`/`providerPaymentId` are the external gateway references.
model Order {
  id              String              @id @default(cuid())
  orderNumber     String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  status          OrderStatus         @default(PENDING)
  paymentStatus   PaymentStatus       @default(UNPAID)
  currency        String              @default("USD")
  subtotalCents   Int
  discountCents   Int                 @default(0)
  totalCents      Int
  provider        PaymentProviderType @default(MANUAL)
  providerOrderId String?
  providerPaymentId String?
  items           OrderItem[]
  paymentEvents   PaymentEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([createdAt])
}

/// A single line of an order. name/image/price are SNAPSHOTS taken at order
/// time so historical orders stay correct even if the catalog or registry
/// changes later.
model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  productId      Int
  productName    String
  productNameAr  String?
  productImage   String?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  billing        Billing @default(MONTHLY)

  @@index([orderId])
  @@index([productId])
}

/// Every incoming payment webhook event. `@@unique([provider, eventId])` is
/// the database-level idempotency guard: a duplicated event cannot be applied
/// twice (no double-payment / double-processing).
model PaymentEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderType
  eventId     String
  eventType   String
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String?
  payloadHash String              @default("")
  processed   Boolean             @default(false)
  processedAt DateTime?
  createdAt   DateTime            @default(now())

  @@unique([provider, eventId])
  @@index([orderId])
  @@index([processed])
}

/// Trusted server-side pricing/snapshot registry derived from the static
/// frontend catalog. Used to re-price every order line server-side. Not a
/// full product catalog (no features/descriptions) — only what orders need.
model ProductPrice {
  id          String  @id @default(cuid())
  productId   Int     @unique
  name        String
  nameAr      String?
  image       String?
  amountCents Int
  billing     Billing @default(MONTHLY)
  currency    String  @default("USD")
  available   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}
