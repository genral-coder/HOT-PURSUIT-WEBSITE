# ═══════════════════════════════════════════════════════════════
#   HOT PURSUIT RP — Environment template
#   Copy this file to `.env` and fill real values.
#   NEVER commit the real `.env` file or any real secrets.
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# PostgreSQL (apps/api)
# Prisma reads this from the root .env (the API runs from the monorepo root,
# so DATABASE_URL + the secrets below all live in the shared root .env).
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hot_pursuit"

# ──────────────────────────────────────────────────────────────
# Backend (apps/api)
# ──────────────────────────────────────────────────────────────
# Port the REST API listens on
PORT=4000
NODE_ENV=development

# Allowed frontend origin (CORS + OAuth redirect target)
# - Vite dev server:
CLIENT_ORIGIN="http://localhost:5173"

# ──────────────────────────────────────────────────────────────
# Discord OAuth2 (apps/api) — Server-side ONLY.
# The Client Secret must NEVER be exposed to the frontend.
# Create an application at https://discord.com/developers/applications
# and add "http://localhost:4000/api/auth/discord/callback" as a redirect URL.
# ──────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/discord/callback"

# ──────────────────────────────────────────────────────────────
# Session / cookie security (apps/api)
# SESSION_SECRET: use a long random string (e.g. `openssl rand -hex 32`).
# ──────────────────────────────────────────────────────────────
SESSION_SECRET=""
# Force Secure cookies. Default in production = true. Leave unset for local dev.
# SESSION_SECURE=true
# SameSite policy. Production (cross-site) = none; local dev = lax.
# SESSION_SAMESITE=lax
# Optional explicit cookie domain in production.
# COOKIE_DOMAIN=example.com
# Session lifetime in ms (default 7 days).
# SESSION_MAX_AGE_MS=604800000

# ──────────────────────────────────────────────────────────────
# Owner authorization (apps/api) — Server-side ONLY.
# Comma-separated Discord USER IDs who are granted OWNER (full access).
# Resolved purely on the backend. Never grant Owner from the client.
# ──────────────────────────────────────────────────────────────
OWNER_DISCORD_IDS=""

# ──────────────────────────────────────────────────────────────
# Payments & orders (apps/api, Phase 6)
# ──────────────────────────────────────────────────────────────
# Which backend owns payments. Supported values:
#   (empty)  → MANUAL. Orders are created but no payment session is produced;
#              the legacy Discord-ticket purchase flow remains the path.
#   mock     → DEVELOPMENT-ONLY simulator. Refuses to boot in production and
#              MUST never be enabled in production. Exposes a dev-only
#              "pay" URL so the full signed-webhook pipeline can be tested
#              locally end-to-end.
#   stripe / paypal / tebex → future production providers (not wired yet; no
#              real credentials are available — nothing is faked).
PAYMENT_PROVIDER=""
# Currency code used for pricing (matches the catalog, currently USD).
PAYMENT_CURRENCY="USD"
# Public API base URL used by the mock provider (and future providers) to
# build absolute checkout / webhook URLs the browser can reach. Defaults to
# localhost:4000 which matches the API PORT above.
# API_BASE_URL="http://localhost:4000"
# Shared secret used to verify incoming payment webhook signatures.
# Generate with `openssl rand -hex 32`. NEVER share with the frontend.
PAYMENT_WEBHOOK_SECRET=""
# Per-provider secrets are ONLY set once a real provider is integrated
# (leave empty):
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# TEBEX_API_KEY=""

# ──────────────────────────────────────────────────────────────
# Frontend (apps/web) — public build-time values only.
# NEVER put secrets here (they would be shipped to the browser).
# ──────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:4000/api"

# ──────────────────────────────────────────────────────────────
# Future integrations (not used in Phase 3/6) — leave empty.
# ──────────────────────────────────────────────────────────────
# DISCORD_BOT_TOKEN=
# FIVEM_SERVER_ADDRESS=
