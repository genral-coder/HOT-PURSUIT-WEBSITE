{
  "name": "hot-pursuit-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HOT PURSUIT RP — production monorepo (web + api + shared packages)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hotpursuit/web",
    "dev:web": "npm run dev --workspace @hotpursuit/web",
    "build": "npm run build --workspace @hotpursuit/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
